  ) %>%
  select(
    -disease_order
  )

# ============================================================
# Plot helper functions
# ============================================================

significance_label <- function(p) {

  if (p < 0.001) {
    "***"
  } else if (p < 0.01) {
    "**"
  } else if (p < 0.05) {
    "*"
  } else {
    "ns"
  }
}

calculate_axis <- function(x) {

  data_min <- min(
    x,
    na.rm = TRUE
  )

  data_max <- max(
    x,
    na.rm = TRUE
  )

  data_range <- data_max -
    data_min

  if (data_range < 0.5) {

    padding <- data_range * 0.5

  } else if (data_range < 1) {

    padding <- data_range * 0.35

  } else if (data_range < 2) {

    padding <- data_range * 0.25

  } else {

    padding <- data_range * 0.15
  }

  axis_min <- data_min -
    padding

  axis_max <- data_max +
    padding

  axis_range <- axis_max -
    axis_min

  if (axis_range < 2) {

    axis_mid <- (
      axis_min +
        axis_max
    ) / 2

    axis_min <- axis_mid - 1
    axis_max <- axis_mid + 1

    step <- 1

  } else if (axis_range < 6) {

    step <- 1

  } else if (axis_range < 10) {

    step <- 2

  } else {

    step <- ceiling(
      axis_range / 5
    )
  }

  breaks <- seq(
    floor(axis_min / step) * step,
    ceiling(axis_max / step) * step,
    by = step
  )

  while (length(breaks) > 5) {

    step <- step + 1

    breaks <- seq(
      floor(axis_min / step) * step,
      ceiling(axis_max / step) * step,
      by = step
    )
  }

  list(
    minimum = axis_min,
    maximum = axis_max,
    breaks = breaks
  )
}

# ============================================================
# Generate violin-plot panels
# ============================================================

plot_list <- list()

for (i in seq_len(nrow(p_value_table))) {

  panel_label <- p_value_table$study_disease[i]
  disease_name <- p_value_table$disease_name[i]
  study_name <- p_value_table$study[i]
  p_value <- p_value_table$p_value[i]

  panel_data <- plot_data[
    plot_data$study_disease == panel_label,
    ,
    drop = FALSE
  ]

  axis_settings <- calculate_axis(
    panel_data$log_odds
  )

  roc_result <- roc(
    response = as.numeric(
      panel_data$group
    ) - 1,
    predictor = panel_data$log_odds,
    quiet = TRUE
  )

  auc_value <- as.numeric(
    auc(
      roc_result
    )
  )

  auc_label <- paste0(
    "AUC = ",
    formatC(
      auc_value,
      digits = 3,
      format = "fg"
    )
  )

  significance_y <- axis_settings$maximum -
    (
      axis_settings$maximum -
        axis_settings$minimum
    ) *
    0.1

  # For the combined general-health panel, reverse the visual order
  if (study_name == "Combined cohort") {

    left_group <- "Disease"
    right_group <- "Control"

  } else {

    left_group <- "Control"
    right_group <- "Disease"
  }

  violin_plot <- ggplot(
    panel_data,
    aes(
      x = 1,
      y = log_odds
    )
  ) +
    geom_violin(
      data = panel_data[
        panel_data$group == left_group,
        ,
        drop = FALSE
      ],
      fill = "#91bfdb",
      position = position_nudge(
        x = -0.12
      ),
      width = 0.4,
      alpha = 0.6
    ) +
    geom_violin(
      data = panel_data[
        panel_data$group == right_group,
        ,
        drop = FALSE
      ],
      fill = "#fc8d59",
      position = position_nudge(
        x = 0.12
      ),
      width = 0.4,
      alpha = 0.6
    ) +
    geom_boxplot(
      data = panel_data[
        panel_data$group == left_group,
        ,
        drop = FALSE
      ],
      width = 0.2,
      position = position_nudge(
        x = -0.12
      ),
      outlier.shape = NA
    ) +
    geom_boxplot(
      data = panel_data[
        panel_data$group == right_group,
        ,
        drop = FALSE
      ],
      width = 0.2,
      position = position_nudge(
        x = 0.12
      ),
      outlier.shape = NA
    ) +
    annotate(
      "text",
      x = 1,
      y = significance_y,
      label = significance_label(
        p_value
      ),
      size = 5 / 2.845
    ) +
    scale_x_continuous(
      breaks = NULL
    ) +
    scale_y_continuous(
      breaks = axis_settings$breaks,
      limits = c(
        axis_settings$minimum,
        axis_settings$maximum
      )
    ) +
    theme_minimal(
      base_size = 5
    ) +
    theme(
      axis.title = element_blank(),
      axis.text.x = element_blank(),
      axis.text = element_text(
        size = 5
      ),
      legend.position = "none",
      panel.grid.minor = element_blank(),
      panel.border = element_rect(
        colour = "black",
        fill = NA,
        linewidth = 0.4
      )
    )

  title_grob <- grobTree(
    rectGrob(
      gp = gpar(
        fill = "#E6E6E6",
        col = "black",
        lwd = 0.6
      )
    ),
    textGrob(
      panel_label,
      gp = gpar(
        fontsize = 2.5,
        fontface = "bold"
      )
    )
  )

  auc_grob <- grobTree(
    rectGrob(
      gp = gpar(
        fill = "#DCEEFF",
        col = "black",
        lwd = 0.6
      )
    ),
    textGrob(
      auc_label,
      gp = gpar(
        fontsize = 5
      )
    )
  )

  p_value_label <- paste0(
    "p = ",
    formatC(
      p_value,
      digits = 3,
      format = "e"
    )
  )

  p_value_grob <- grobTree(
    rectGrob(
      gp = gpar(
        fill = "#FFE6D5",
        col = "black",
        lwd = 0.6
      )
    ),
    textGrob(
      p_value_label,
      gp = gpar(
        fontsize = 5
      )
    )
  )

  combined_panel <- arrangeGrob(
    title_grob,
    auc_grob,
    p_value_grob,
    violin_plot,
    ncol = 1,
    heights = c(
      0.12,
      0.10,
      0.10,
      0.68
    )
  )

  final_panel <- grobTree(
    rectGrob(
      gp = gpar(
        fill = NA,
        col = "black",
        lwd = 1
      )
    ),
    combined_panel
  )

  plot_list[[panel_label]] <- final_panel
}

