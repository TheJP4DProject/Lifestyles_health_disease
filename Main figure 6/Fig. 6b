# ============================================================
# CLR transformation and standardization
# ============================================================

clr_transform <- function(x) {

  x[x == 0] <- min(
    x[x > 0]
  ) / 2

  log_x <- log(x)

  sweep(
    log_x,
    1,
    rowMeans(log_x),
    "-"
  )
}

standardize_columns <- function(x) {

  scaled_x <- scale(x)

  colnames(scaled_x) <- colnames(x)
  rownames(scaled_x) <- rownames(x)

  scaled_x
}

extract_feature_id <- function(x) {

  gsub(
    ".*\\[ID:([0-9]{5})\\].*",
    "\\1",
    x
  )
}

# ============================================================
# Predict log-odds scores
# ============================================================

predict_logodds <- function(
    model_file,
    abundance
) {

  model <- readRDS(
    model_file
  )

  model_features <- rownames(
    model$cvfit$glmnet.fit$beta
  )

  feature_ids <- extract_feature_id(
    model_features
  )

  design_matrix <- matrix(
    0,
    nrow = nrow(abundance),
    ncol = length(model_features),
    dimnames = list(
      rownames(abundance),
      model_features
    )
  )

  for (i in seq_along(feature_ids)) {

    if (feature_ids[i] %in% colnames(abundance)) {

      design_matrix[, i] <- abundance[
        ,
        feature_ids[i]
      ]
    }
  }

  as.numeric(
    predict(
      model$cvfit,
      newx = design_matrix,
      s = model$lambda_1se,
      type = "link"
    )
  )
}

# ============================================================
# Collect validation results
# ============================================================

all_plot_data <- list()
p_value_data <- list()
summary_data <- list()

for (study_name in unique(metadata$study)) {

  study_metadata <- metadata %>%
    filter(
      study == study_name
    )

  disease_key <- setdiff(
    unique(study_metadata$disease),
    "CTR"
  )

  if (length(disease_key) == 0) {
    next
  }

  disease_name <- disease_list %>%
    filter(
      tolower(disease) ==
        tolower(disease_key[1])
    ) %>%
    pull(name)

  disease_name <- disease_name[1]

  abundance <- motu[
    study_metadata$sample_alias,
    ,
    drop = FALSE
  ]

  abundance <- abundance[
    ,
    colSums(abundance) > 0,
    drop = FALSE
  ]

  colnames(abundance) <- sub(
    ".*v3_([0-9]{5})\\].*",
    "\\1",
    colnames(abundance)
  )

  abundance <- clr_transform(
    abundance
  )

  abundance <- standardize_columns(
    abundance[, -1, drop = FALSE]
  )

  model_file <- file.path(
    MODEL_DIR,
    paste0(
      gsub(
        " ",
        ".",
        disease_name
      ),
      "_sp.rds"
    )
  )

  study_metadata$log_odds <- predict_logodds(
    model_file,
    abundance
  )

  study_metadata$group <- ifelse(
    study_metadata$HealthCTR != 0,
    "Control",
    "Disease"
  )

  study_metadata$study_disease <- paste0(
    study_name,
    "\n",
    disease_name
  )

  study_metadata$disease_name <- disease_name

  control_scores <- study_metadata$log_odds[
    study_metadata$group == "Control"
  ]

  disease_scores <- study_metadata$log_odds[
    study_metadata$group == "Disease"
  ]

  p_value <- wilcox.test(
    control_scores,
    disease_scores
  )$p.value

  all_plot_data[[study_name]] <- study_metadata

  p_value_data[[study_name]] <- data.frame(
    study_disease = study_metadata$study_disease[1],
    disease_name = disease_name,
    study = study_name,
    p_value = p_value,
    stringsAsFactors = FALSE
  )

  summary_data[[study_name]] <- data.frame(
    study = study_name,
    disease_name = disease_name,
    median_control = median(
      control_scores,
      na.rm = TRUE
    ),
    median_disease = median(
      disease_scores,
      na.rm = TRUE
    ),
    mean_control = mean(
      control_scores,
      na.rm = TRUE
    ),
    mean_disease = mean(
      disease_scores,
      na.rm = TRUE
    ),
    sd_control = sd(
      control_scores,
      na.rm = TRUE
    ),
    sd_disease = sd(
      disease_scores,
      na.rm = TRUE
    ),
    se_control = sd(
      control_scores,
      na.rm = TRUE
    ) / sqrt(length(control_scores)),
    se_disease = sd(
      disease_scores,
      na.rm = TRUE
    ) / sqrt(length(disease_scores)),
    p_value = p_value,
    n_control = length(control_scores),
    n_disease = length(disease_scores),
    n_total = length(control_scores) +
      length(disease_scores),
    stringsAsFactors = FALSE
  )
}

