)

# Read and align the cross-sectional and longitudinal tables
data1 = read.xlsx("Supplementary Tables.xlsx",
sheet="S6",
check.names = F,
sep.names = " ")
colnames(data1)[c(2,3,6)]=c("feature","metadata","qval")
data1=data1[,c("metadata","feature","coef","pval")]
colnames(data1)=c("meta","feature","coef","pvalue")
data2 = read.csv("keiji_410_lm_20250317.csv")
data2=data2[,c("meta","feature","coef","pvalue")]
colnames(data2)=c("meta","feature","coef","pvalue")
key1 = "Cross-sectional analysis"
key2 = "Longitudinal analysis"
tit = "Ver2_oudan_maa_vs_jyudan_lm_20260204"

# Global figure settings
FEATURE_FONT_SIZE <- 4
OTHER_FONT_SIZE <- 5

# A4 paper short-side width = 210 mm = 8.27 inch
FIG_WIDTH <- 8.27
FIG_HEIGHT <- 7

# Heatmap square height
HEATMAP_ROW_HEIGHT <- unit(2, "mm")

# Gap between the upper and lower heatmaps
HEATMAP_GAP <- unit(0.5, "mm")

colnames(data1) = paste0("oudan_", colnames(data1))
colnames(data2) = paste0("jyudan_", colnames(data2))


unique(data2$jyudan_meta)

data1=data1[data1$oudan_meta %in% data2$jyudan_meta,]
data1$key=paste0(data1$oudan_feature,data1$oudan_meta)
data2$key=paste0(data2$jyudan_feature,data2$jyudan_meta)
rownames(data1)=data1$key
data1=data1[data2$key,]

temp = cbind(data1, data2)
sum(temp$jyudan_feature != temp$oudan_feature)
sum(temp$oudan_meta != temp$jyudan_meta)
tempp = temp[(temp$oudan_pvalue < 0.05) | (temp$jyudan_pvalue < 0.05), ]
tempp=na.omit(tempp)
r=NULL
for ( i in unique(tempp$oudan_meta)){
temppp=tempp[tempp$oudan_meta==i,]
nn=nrow(temppp)
temppp=cor.test(temppp$oudan_coef,temppp$jyudan_coef,method="spearman")
r=rbind(r,data.frame(meta=i,
cate=tit,
r=temppp$estimate,
p=temppp$p.value,
n=nn,
type="orP005"))
}

tempp=cor.test(tempp$oudan_coef,tempp$jyudan_coef,method="spearman")
data.frame(r=tempp$estimate,
p=tempp$p.value)

tempp = temp
for ( i in unique(tempp$oudan_meta)){
temppp=tempp[tempp$oudan_meta==i,]
nn=nrow(temppp)
temppp=cor.test(temppp$oudan_coef,temppp$jyudan_coef,method="spearman")
r=rbind(r,data.frame(meta=i,
cate=tit,
r=temppp$estimate,
p=temppp$p.value,
n=nn,
type="ALL"))
}

tempp=cor.test(tempp$oudan_coef,tempp$jyudan_coef,method="spearman")
data.frame(r=tempp$estimate,
p=tempp$p.value)

temp = temp[(temp$oudan_pvalue < 0.05) & (temp$jyudan_pvalue < 0.05), ]
temp = temp[temp$oudan_coef * temp$jyudan_coef > 0, ]
temp = na.omit(temp)

original_data = temp
original_data$annotation = ordered_df[original_data$oudan_meta, ]$annotation
original_data$annotation2 = ordered_df[original_data$oudan_meta, ]$annotation2
original_data=original_data[,-grep("key",colnames(original_data))]
original_data <- original_data %>%
mutate(group = factor(oudan_meta, levels = ordered_df$group)) %>%
arrange(group, oudan_coef)

original_data$oudan_meta <- factor(original_data$oudan_meta, levels = unique(original_data$oudan_meta))

# Split the heatmap into five panels according to the number of features.
# Do not split within the same metadata category.
meta_count <- original_data %>%
count(oudan_meta, name = "n_feature") %>%
mutate(
oudan_meta = as.character(oudan_meta),
cumulative_n = cumsum(n_feature)
)

total_n <- nrow(original_data)

target_1 <- total_n * 1 / 5
target_2 <- total_n * 2 / 5
target_3 <- total_n * 3 / 5
target_4 <- total_n * 4 / 5

find_nearest_split <- function(target, min_index, max_index) {
candidate_index <- seq.int(min_index, max_index)
candidate_index[
which.min(abs(meta_count$cumulative_n[candidate_index] - target))
]
}

split_index_1 <- find_nearest_split(
target = target_1,
min_index = 1,
max_index = nrow(meta_count) - 4
)

split_index_2 <- find_nearest_split(
target = target_2,
min_index = split_index_1 + 1,
max_index = nrow(meta_count) - 3
)

split_index_3 <- find_nearest_split(
target = target_3,
min_index = split_index_2 + 1,
max_index = nrow(meta_count) - 2
)

split_index_4 <- find_nearest_split(
target = target_4,
min_index = split_index_3 + 1,
max_index = nrow(meta_count) - 1
)

split_meta_1 <- meta_count$oudan_meta[split_index_1]
split_meta_2 <- meta_count$oudan_meta[split_index_2]
split_meta_3 <- meta_count$oudan_meta[split_index_3]
split_meta_4 <- meta_count$oudan_meta[split_index_4]

check1 <- meta_count$cumulative_n[split_index_1]
check2 <- meta_count$cumulative_n[split_index_2]
check3 <- meta_count$cumulative_n[split_index_3]
check4 <- meta_count$cumulative_n[split_index_4]

cat("\nAutomatic split result:\n")
cat("Part 1:", 1, "-", check1, " columns; ends at ", split_meta_1, "\n", sep = "")
cat("Part 2:", check1 + 1, "-", check2, " columns; ends at ", split_meta_2, "\n", sep = "")
cat("Part 3:", check2 + 1, "-", check3, " columns; ends at ", split_meta_3, "\n", sep = "")
cat("Part 4:", check3 + 1, "-", check4, " columns; ends at ", split_meta_4, "\n", sep = "")
cat("Part 5:", check4 + 1, "-", total_n, " columns; ends at final metadata\n\n", sep = "")

tt <- unique(ordered_df[, c("color", "annotation")])
ttt <- unique(tt[, c("color", "annotation")])
col_M <- setNames(ttt$color, ttt$annotation)

col_fun = colorRamp2(c(-0.4, 0, 0.4), c("#091B7D", "white", "#C71585"))
col_5137 = colorRamp2(c(-0.2, 0, 0.2), c("blue", "white", "red"))

# Build one heatmap panel.
plot_one_part <- function(data_part, part_id) {

data_part$oudan_meta <- factor(
data_part$oudan_meta,
levels = unique(data_part$oudan_meta)
)

data_part <- data_part %>%
group_by(jyudan_feature) %>%
mutate(
feature_id = if (n() > 1) {
paste0(jyudan_feature, " ", row_number())
} else {
jyudan_feature
}
) %>%
ungroup()

hm_logFC <- data_part %>%
select(feature_id, jyudan_coef) %>%
tibble::column_to_rownames(var = "feature_id") %>%
t()

hm_pval <- data_part %>%
select(feature_id, jyudan_pvalue) %>%
tibble::column_to_rownames(var = "feature_id") %>%
t()

hm_coef <- data_part %>%
select(feature_id, oudan_coef) %>%
tibble::column_to_rownames(var = "feature_id") %>%
t()

hm_pvalMaa <- data_part %>%
select(feature_id, oudan_pvalue) %>%
tibble::column_to_rownames(var = "feature_id") %>%
t()

rownames(hm_logFC) <- key2
rownames(hm_coef) <- key1

colnames(hm_coef) <- sapply(colnames(hm_coef), function(name) {
if (grepl(" \\d+$", name)) {
num <- as.numeric(sub(".* (\\d+)$", "\\1", name))
name <- sub(" \\d+$", "", name)
name <- paste0(strrep(" ", num), name)
}
return(name)
})

colnames(hm_coef) <- gsub("\\[ID:(\\d+)\\]", "\\1", colnames(hm_coef))
colnames(hm_logFC) <- colnames(hm_coef)
colnames(hm_pval) <- colnames(hm_coef)
colnames(hm_pvalMaa) <- colnames(hm_coef)

Annotation_top <- HeatmapAnnotation(
Classification = data_part$annotation,
annotation_name_gp = gpar(fontsize = OTHER_FONT_SIZE),
annotation_name_rot = 0,
col = list(Classification = col_M),
simple_anno_size = unit(0.2, "cm"),
annotation_name_side = "left",
show_legend = FALSE
)

hm_top <- Heatmap(
hm_logFC,
name = "up",
cluster_rows = FALSE,
cluster_columns = FALSE,
col = col_fun,
row_title = " ",
row_title_gp = gpar(fontsize = OTHER_FONT_SIZE),
row_dend_side = "right",
row_names_side = "left",
height = HEATMAP_ROW_HEIGHT,
show_row_names = FALSE,
column_split = data_part$oudan_meta,
column_title_rot = 45,
column_title_gp = gpar(fontsize = OTHER_FONT_SIZE),
column_names_gp = gpar(fontsize = FEATURE_FONT_SIZE),
show_column_names = FALSE,
show_heatmap_legend = FALSE,
cell_fun = function(j, i, x, y, width, height, fill) {
if (hm_pval[i, j] < 0.05) {
grid.text(
"*",
x,
y,
vjust = 0.75,
gp = gpar(fontsize = OTHER_FONT_SIZE)
)
}
}
)

hm_bottom <- Heatmap(
hm_coef,
name = "down",
cluster_columns = FALSE,
cluster_rows = FALSE,
col = col_5137,
row_title = " ",
row_title_gp = gpar(fontsize = OTHER_FONT_SIZE),
column_split = data_part$oudan_meta,
column_title = unique(data_part$oudan_meta),
row_dend_side = "right",
row_names_side = "left",
height = HEATMAP_ROW_HEIGHT,
show_row_names = FALSE,
column_title_rot = 45,
column_title_gp = gpar(fontsize = OTHER_FONT_SIZE),
column_names_gp = gpar(fontsize = FEATURE_FONT_SIZE),
show_heatmap_legend = FALSE,
cell_fun = function(j, i, x, y, width, height, fill) {
if (!is.na(hm_pvalMaa[i, j]) && hm_pvalMaa[i, j] < 0.05) {
grid.text(
"*",
x,
y,
vjust = 0.75,
gp = gpar(fontsize = OTHER_FONT_SIZE)
)
}
}
)

cairo_pdf(
file = paste0(tit, "_part", part_id, ".pdf"),
width = FIG_WIDTH,
height = FIG_HEIGHT,
family = "Helvetica"
)

ht <- draw(
hm_top %v% hm_bottom,
ht_gap = HEATMAP_GAP,
padding = unit(c(80, 2, 2, 2), "mm")
)

dev.off()
}

# Build the five heatmap panels.
data_part1 <- original_data[1:check1, ]
data_part2 <- original_data[(check1 + 1):check2, ]
data_part3 <- original_data[(check2 + 1):check3, ]
data_part4 <- original_data[(check3 + 1):check4, ]
data_part5 <- original_data[(check4 + 1):nrow(original_data), ]

plot_one_part(data_part1, 1)
plot_one_part(data_part2, 2)
plot_one_part(data_part3, 3)
plot_one_part(data_part4, 4)
plot_one_part(data_part5, 5)

# Add FDR values and write the source-data table
temp_full <- temp
temp_full <- temp_full[, !duplicated(colnames(temp_full))]

temp_full <- temp_full %>%
group_by(oudan_meta) %>%
mutate(oudan_fdr = p.adjust(oudan_pvalue, method = "BH")) %>%
ungroup()

temp_full <- temp_full %>%
group_by(jyudan_meta) %>%
mutate(jyudan_fdr = p.adjust(jyudan_pvalue, method = "BH")) %>%
ungroup()

newtoold = read.csv(file.path("smoking","motu3","SP_new_old.csv"),
row.names = 1,
stringsAsFactors = FALSE)

rownames(newtoold) <- newtoold$new

temp_full$NCBI <- newtoold[temp_full$oudan_feature, "old"]

source_data <- temp_full %>%
select(
GTDB = oudan_feature,
NCBI,
Metadata = oudan_meta,
Cross-sectional Coefficient = oudan_coef,
Cross-sectional P = oudan_pvalue,
Cross-sectional FDR = oudan_fdr,
Longitudinal Coefficient = jyudan_coef,
Longitudinal P = jyudan_pvalue,
Longitudinal FDR = jyudan_fdr
)

colnames(source_data) <- colnames(source_data) %>%
gsub("_", " ", .) %>%
gsub("Coefficient", "Coefficient", .) %>%
gsub("P$", "P", .)

write.csv(source_data,
paste0(tit, "_source_data.csv"),
row.names = FALSE)
