# ============================================================
# R2 versus causal mediation count
#
# All analyses use the original R2 values and causal mediation
# counts without out-of-range transformation.
# ============================================================

library(dplyr)
library(ggplot2)

# ============================================================
# File paths
# ============================================================

CAUSAL_FILE <- "data/causal_input.csv"
BETA_R2_FILE <- "data/beta_r2.csv"

OUTPUT_DIR <- "results/figures"

dir.create(
  OUTPUT_DIR,
  recursive = TRUE,
  showWarnings = FALSE
)

# ============================================================
# Disease categories
# ============================================================

category_map <- data.frame(
  Disease = c(
    "General health",
    "IBD",
    "IBS",
    "Liver cirrhosis",
    "T2D",
    "Dyslipidemia",
    "Hypertension",
    "Hyperuricemia",
    "IHD",
    "Heart failure",
    "Stroke",
    "Depression",
    "Rheumatoid arthritis",
    "Collagen disease",
    "Asthma",
    "COPD"
  ),
  Category = c(
    "General health",
    "Digestive",
    "Digestive",
    "Digestive",
    "Metabolic",
    "Metabolic",
    "Metabolic",
    "Metabolic",
    "Cardiovascular",
    "Cardiovascular",
    "Cardiovascular",
    "Psychiatric",
    "Immune",
    "Immune",
    "Respiratory",
    "Respiratory"
  ),
  stringsAsFactors = FALSE
)

category_order <- c(
  "General health",
  "Digestive",
  "Metabolic",
  "Cardiovascular",
  "Psychiatric",
  "Immune",
  "Respiratory"
)

category_colors <- c(
  "General health" = "#fb9a99",
  "Digestive" = "#CCBE93",
  "Metabolic" = "#a6cee3",
  "Cardiovascular" = "#1f78b4",
  "Psychiatric" = "#b2df8a",
  "Immune" = "#18BC9C",
  "Respiratory" = "#fdbf6f"
)

disease_order <- category_map$Disease

# ============================================================
# Causal mediation count
# ============================================================

causal_data <- read.csv(
  CAUSAL_FILE,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

count_data <- causal_data %>%
  filter(
    Avg_causal_mediation_qval < 0.05,
    Inv_Avg_causal_mediation_pval >= 0.05
  ) %>%
  count(
    Disease,
    name = "causal_count"
  ) %>%
  left_join(
    category_map,
    by = "Disease"
  )

# ============================================================
# mOTU beta-diversity R2
# ============================================================

r2_data <- read.csv(
  BETA_R2_FILE,
  stringsAsFactors = FALSE,
  check.names = FALSE
)

r2_motu <- r2_data %>%
  filter(
    type == "MOTU"
  ) %>%
  group_by(
    Disease
  ) %>%
  summarise(
    R2 = mean(
      R2,
      na.rm = TRUE
    ),
    .groups = "drop"
  )

# ============================================================
# Merge data
# ============================================================

plot_data <- count_data %>%
  left_join(
    r2_motu,
    by = "Disease"
  ) %>%
  filter(
    !is.na(R2),
    is.finite(R2)
  ) %>%
  mutate(
    Category = factor(
      Category,
      levels = category_order
    )
  )

# ============================================================
# Spearman correlation
# ============================================================

spearman_result <- cor.test(
  plot_data$R2,
  plot_data$causal_count,
  method = "spearman",
  exact = FALSE
)

correlation_label <- paste0(
  "rho = ",
  round(
    unname(spearman_result$estimate),
    3
  ),
  "\np = ",
  signif(
    spearman_result$p.value,
    2
  )
)

# ============================================================
# Plot
# ============================================================

p <- ggplot(
  plot_data,
  aes(
    x = R2,
    y = causal_count
  )
) +
  geom_smooth(
    method = "lm",
    color = "grey40",
    fill = "grey85",
    linewidth = 0.5,
    se = TRUE
  ) +
  geom_point(
    aes(
      color = Category
    ),
    shape = 16,
    size = 1.6,
    alpha = 0.9
  ) +
  scale_color_manual(
    values = category_colors,
    limits = category_order,
    drop = FALSE
  ) +
  scale_x_continuous(
    breaks = seq(
      0,
      0.00150,
      by = 0.00025
    ),
    labels = c(
      "0",
      "0.00025",
      "0.00050",
      "0.00075",
      "0.00100",
      "0.00125",
      "0.00150"
    ),
    limits = c(
      0,
      0.00150
    ),
    expand = expansion(
      mult = c(0, 0)
    )
  ) +
  scale_y_continuous(
    expand = expansion(
      mult = c(0.02, 0.05)
    )
  ) +
  labs(
    x = expression(
      R^2 ~ "(mOTU beta-diversity)"
    ),
    y = "Causal mediation count",
    color = "Category"
  ) +
  annotate(
    "text",
    x = -Inf,
    y = Inf,
    label = correlation_label,
    hjust = -0.05,
    vjust = 1.05,
    size = 2.5,
    color = "black"
  ) +
  theme_classic(
    base_size = 5
  ) +
  theme(
    panel.border = element_rect(
      color = "grey70",
      fill = NA,
      linewidth = 0.5
    ),
    axis.text = element_text(
      size = 5,
      color = "black"
    ),
    axis.title = element_text(
      size = 5,
      color = "black"
    ),
    legend.title = element_text(
      size = 5
    ),
    legend.text = element_text(
      size = 5
    ),
    legend.key.size = grid::unit(
      4,
      "pt"
    ),
    legend.spacing.y = grid::unit(
      0,
      "pt"
    ),
    plot.margin = margin(
      t = 3,
      r = 3,
      b = 3,
      l = 3,
      unit = "pt"
    )
  ) +
  guides(
    color = guide_legend(
      override.aes = list(
        shape = 16,
        size = 2.4,
        alpha = 1
      )
    )
  )

# ============================================================
# Save figure
# ============================================================

ggsave(
  filename = file.path(
    OUTPUT_DIR,
    "r2_vs_causal_mediation_count.pdf"
  ),
  plot = p,
  width = 2.25,
  height = 1.5,
  units = "in",
  useDingbats = FALSE
)

# ============================================================
# Save plotting data
# ============================================================

output_data <- plot_data %>%
  select(
    Disease,
    Category,
    causal_count,
    R2
  ) %>%
  mutate(
    Disease = factor(
      Disease,
      levels = disease_order
    )
  ) %>%
  arrange(
    Disease
  ) %>%
  mutate(
    Disease = as.character(Disease),
    Category = as.character(Category)
  )

write.csv(
  output_data,
  file.path(
    OUTPUT_DIR,
    "r2_vs_causal_mediation_count.csv"
  ),
  row.names = FALSE
)
