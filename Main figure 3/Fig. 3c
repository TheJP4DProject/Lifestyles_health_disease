rm(list = ls())
set.seed(100)

library(tidyverse)
library(openxlsx)
library(htmlwidgets)
library(htmltools)
library(networkD3)

# ============================================================
# Lifestyle variable order and classification
# ============================================================

ordered_df <- data.frame(
  group = c(
    "Vegetables",
    "Fruits",
    "Mushrooms",
    "Vinegar",
    "Tofu",
    "Coffee",
    "Green tea",
    "Natto",
    "Miso",
    "Pickles",
    "Kimchi",
    "Yogurt",
    "Milk",
    "Meat",
    "Processed meat",
    "Seafood",
    "Eggs",
    "Dressing",
    "Rice",
    "Bread",
    "Noodles",
    "Soft drinks",
    "Alcohol",
    "Smoking",
    "Strong physical activity",
    "Moderate physical activity",
    "Weak physical activity",
    "Sitting down ≥ 9.5h"
  ),

  annotation = c(
    rep("Plant-based diets", 5),
    rep("Polyphenol-rich beverages", 2),
    rep("Fermented diets", 4),
    rep("Dairy products", 2),
    rep("Animal-based diets", 5),
    rep("Refined carbohydrates", 4),
    rep("Alcohol/Smoking", 2),
    rep("Exercise", 4)
  ),

  color = c(
    rep("#66c2a5", 5),
    rep("#b3b3b3", 2),
    rep("#fc8d62", 4),
    rep("#8da0cb", 2),
    rep("#e78ac3", 5),
