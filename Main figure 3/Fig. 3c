    rep("#ffd92f", 2),
    rep("#e5c494", 4)
  ),

  stringsAsFactors = FALSE
)

rownames(ordered_df) <- ordered_df$group

# ============================================================
# Disease order
# ============================================================

disease_list <- data.frame(
  group = c(
    "General health",
    "Inflammatory Bowel Disease (IBD)",
    "Irritable Bowel Syndrome (IBS)",
    "Liver cirrhosis",
    "Type 2 Diabetes (T2D)",
    "Dyslipidemia",
    "Hypertension",
    "Hyperuricemia",
    "Ischemic Heart Disease (IHD)",
    "Heart failure",
    "Stroke",
    "Depression",
    "Rheumatoid arthritis",
    "Collagen disease",
    "Asthma",
    "Chronic Obstructive Pulmonary Disease (COPD)"
  ),

  color = c(
    "white",
    rep("black", 15)
  ),

  stringsAsFactors = FALSE
)

# ============================================================
# Parameters and file paths
# ============================================================

SANKEY_WIDTH <- 850
SANKEY_HEIGHT <- 600

INPUT_FILE <- "data/supplementary_tables.xlsx"
OUTPUT_DIR <- "results/fig3"

OUTPUT_PREFIX <- "TOP20_newfig3C"

dir.create(
  OUTPUT_DIR,
  recursive = TRUE,
  showWarnings = FALSE
)

# ============================================================
# Read causal mediation results
# ============================================================

causal <- read.xlsx(
  INPUT_FILE,
  sheet = "S9_MOTU",
  check.names = FALSE,
  sep.names = " "
)

colnames(causal)[6] <- "Mediator"

# ============================================================
# Read top species list
# ============================================================

species_list <- read.xlsx(
  INPUT_FILE,
  sheet = "S13_TOP20",
  check.names = FALSE,
  sep.names = " "
)

top20 <- species_list$GTDB[1:20]

causal_filtered <- causal %>%
  filter(
    Mediator %in% top20
  )

# Preserve original species labels
causal_filtered$OriginalMediator <- causal_filtered$Mediator

# Remove the ID wrapper for display and matching
causal_filtered$Mediator <- gsub(
  "\\[ID:(\\d+)\\]",
  "\\1",
  causal_filtered$Mediator
)

top20_id <- gsub(
  "\\[ID:(\\d+)\\]",
  "\\1",
  top20
)

species_order <- top20_id[
  top20_id %in% unique(causal_filtered$Mediator)
]

causal_filtered$ExposureClass <- ordered_df[
  causal_filtered$Exposure,
  "annotation"
]

# ============================================================
# Construct nodes
# ============================================================

nodes <- data.frame()

# Exposure nodes
exposure_nodes <- ordered_df$group[
  ordered_df$group %in% causal_filtered$Exposure
]

nodes <- rbind(
  nodes,
  data.frame(
    id = seq_along(exposure_nodes) - 1,
    tag = exposure_nodes,
    display_tag = exposure_nodes,
    group = ordered_df[
      exposure_nodes,
      "annotation"
    ],
    stringsAsFactors = FALSE
  )
)

# Species nodes
species_nodes <- species_order

nodes <- rbind(
  nodes,
  data.frame(
    id = seq_along(species_nodes) - 1 + nrow(nodes),
    tag = species_nodes,
    display_tag = species_nodes,
    group = "Microbial species",
    stringsAsFactors = FALSE
  )
)

# Disease display labels
disease_display_names <- vapply(
  disease_list$group,
  function(x) {

    if (grepl("\\(.*\\)", x)) {

      sub(
        ".*\\(([^()]*)\\).*",
        "\\1",
        x
      )

    } else {

      x
    }
  },
  character(1)
)

names(disease_display_names) <- disease_list$group

disease_nodes <- disease_list$group[
  disease_list$group %in% unique(causal_filtered$Outcome)
]

nodes <- rbind(
  nodes,
  data.frame(
    id = seq_along(disease_nodes) - 1 + nrow(nodes),
    tag = disease_nodes,
    display_tag = unname(
      disease_display_names[disease_nodes]
    ),
    group = ifelse(
      disease_nodes == "General health",
      "Health",
      "Disease"
    ),
    stringsAsFactors = FALSE
  )
)

# ============================================================
# Construct links
# ============================================================

links <- data.frame()

# ------------------------------------------------------------
# Exposure -> species
# ------------------------------------------------------------

for (exposure in exposure_nodes) {

  for (species in species_nodes) {

    positive_links <- causal_filtered %>%
      filter(
        Exposure == exposure,
        Mediator == species,
        EXP_coef > 0
      )

    if (nrow(positive_links) > 0) {

      links <- rbind(
        links,
        data.frame(
          source = exposure,
          target = species,
          value = nrow(positive_links),
          source_id = nodes$id[
            nodes$tag == exposure
          ],
          target_id = nodes$id[
            nodes$tag == species
          ],
          group = "Positive",
          stringsAsFactors = FALSE
        )
      )
    }

    negative_links <- causal_filtered %>%
      filter(
        Exposure == exposure,
        Mediator == species,
        EXP_coef < 0
      )

    if (nrow(negative_links) > 0) {

      links <- rbind(
        links,
        data.frame(
          source = exposure,
          target = species,
          value = nrow(negative_links),
          source_id = nodes$id[
            nodes$tag == exposure
          ],
          target_id = nodes$id[
            nodes$tag == species
          ],
          group = "Negative",
          stringsAsFactors = FALSE
        )
      )
    }
  }
}

# ------------------------------------------------------------
# Species -> disease
# ------------------------------------------------------------

for (species in species_nodes) {

  for (disease in disease_nodes) {

    positive_links <- causal_filtered %>%
      filter(
        Mediator == species,
        Outcome == disease,
        Dis_coef > 0
      )

    if (nrow(positive_links) > 0) {

      links <- rbind(
        links,
        data.frame(
          source = species,
          target = disease,
          value = nrow(positive_links),
          source_id = nodes$id[
            nodes$tag == species
          ],
          target_id = nodes$id[
            nodes$tag == disease
          ],
          group = "Positive",
          stringsAsFactors = FALSE
        )
      )
    }

    negative_links <- causal_filtered %>%
      filter(
        Mediator == species,
        Outcome == disease,
        Dis_coef < 0
      )

    if (nrow(negative_links) > 0) {

      links <- rbind(
        links,
        data.frame(
          source = species,
          target = disease,
          value = nrow(negative_links),
          source_id = nodes$id[
            nodes$tag == species
          ],
          target_id = nodes$id[
            nodes$tag == disease
          ],
          group = "Negative",
          stringsAsFactors = FALSE
        )
      )
    }
  }
}

rownames(nodes) <- NULL
rownames(links) <- NULL

# ============================================================
# Sankey color scale
# ============================================================

color_domain <- c(
  "Plant-based diets",
  "Polyphenol-rich beverages",
  "Fermented diets",
  "Dairy products",
  "Animal-based diets",
  "Refined carbohydrates",
  "Alcohol/Smoking",
  "Exercise",
  "Health",
  "Disease",
  "Positive",
  "Negative",
  "Microbial species"
)

color_range <- c(
  "#66c2a5",
  "#b3b3b3",
  "#fc8d62",
  "#8da0cb",
  "#e78ac3",
  "#a6d854",
  "#ffd92f",
  "#e5c494",
  "white",
  "black",
  "#eca19c",
  "#9cc4ea",
  "black"
)

existing_groups <- unique(
  c(
    nodes$group,
    links$group
  )
)

color_map <- setNames(
  color_range,
  color_domain
)

existing_colors <- color_map[
  existing_groups
]

existing_colors <- existing_colors[
  !is.na(existing_colors)
]

domain_string <- paste0(
  '["',
  paste(
    names(existing_colors),
    collapse = '","'
  ),
  '"]'
)

range_string <- paste0(
  '["',
  paste(
    existing_colors,
    collapse = '","'
  ),
  '"]'
)

sankey_color_scale <- paste0(
  "d3.scaleOrdinal().domain(",
  domain_string,
  ").range(",
  range_string,
  ")"
)

# ============================================================
# Sankey diagram
# ============================================================

sankey_plot <- sankeyNetwork(
  Links = links,
  Nodes = nodes,
  Source = "source_id",
  Target = "target_id",
  Value = "value",
  NodeID = "display_tag",
  colourScale = sankey_color_scale,
  LinkGroup = "group",
  NodeGroup = "group",
  fontSize = 16,
  fontFamily = "Helvetica",
  iterations = 0,
  sinksRight = FALSE,
  width = SANKEY_WIDTH,
  height = SANKEY_HEIGHT,
  nodeWidth = 2
)

sankey_plot <- htmlwidgets::prependContent(
  sankey_plot,
  htmltools::tags$h1(
    OUTPUT_PREFIX,
    style = "text-align:center;"
  )
)

saveNetwork(
  sankey_plot,
  file.path(
    OUTPUT_DIR,
    paste0(
      OUTPUT_PREFIX,
      ".html"
    )
  )
)

# ============================================================
# Prepare associated species annotations
# ============================================================

species_annotation <- read.xlsx(
  INPUT_FILE,
  sheet = "S13_TOP20",
  check.names = FALSE
)

species_annotation$ID_clean <- gsub(
  "\\[ID:(\\d+)\\]",
  "\\1",
  species_annotation$GTDB
)

valid_exposure_species <- links %>%
  filter(
    source %in% ordered_df$group,
    target %in% species_order
  ) %>%
  select(
    Exposure = source,
    Mediator = target
  )

valid_species_disease <- links %>%
  filter(
    source %in% species_order,
    target %in% disease_list$group
  ) %>%
  select(
    Mediator = source,
    Outcome = target
  )

valid_triplets <- causal_filtered %>%
  semi_join(
    valid_exposure_species,
    by = c(
      "Exposure",
      "Mediator"
    )
  ) %>%
  semi_join(
    valid_species_disease,
    by = c(
      "Mediator",
      "Outcome"
    )
  )

output_pairs <- valid_triplets %>%
  left_join(
    species_annotation,
    by = c(
      "Mediator" = "ID_clean"
    )
  )

# ============================================================
# Save output data
# ============================================================

write.csv(
  causal_filtered,
  file.path(
    OUTPUT_DIR,
    "fig3C.csv"
  ),
  row.names = FALSE
)

write.csv(
  output_pairs,
  file.path(
    OUTPUT_DIR,
    "fig3D.csv"
  ),
  row.names = FALSE
)

write.csv(
  nodes,
  file.path(
    OUTPUT_DIR,
    "fig3C_nodes.csv"
  ),
  row.names = FALSE
)

write.csv(
  links,
  file.path(
    OUTPUT_DIR,
    "fig3C_links.csv"
  ),
  row.names = FALSE
)

message(
  "Done: ",
  file.path(
    OUTPUT_DIR,
    paste0(
      OUTPUT_PREFIX,
      ".html"
    )
  )
)
