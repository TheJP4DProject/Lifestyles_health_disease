bar_colors <- plot_info$Color

# =============================================================================
# Alpha-diversity heatmap cells
# =============================================================================

alpha_cell_function <- function(
    rho_matrix,
    p_matrix
) {

  function(
      j,
      i,
      x,
      y,
      width,
      height,
      fill
  ) {

    rho <- rho_matrix[i, j]
    p_value <- p_matrix[i, j]

    if (!is.na(p_value) && p_value < 0.05) {

      cell_color <- ifelse(
        rho > 0,
        "#E68795",
        "#9BC4E2"
      )

    } else {

      cell_color <- "white"
    }

    grid.rect(
      x = x,
      y = y,
      width = width,
      height = height,
      gp = gpar(
        fill = cell_color,
        col = "black",
        lwd = 0.3
      )
    )
  }
}

# =============================================================================
# Combined heatmap
# =============================================================================

heatmap_alpha_beta <- Heatmap(
  alpha_rho,
  cluster_rows = FALSE,
  cluster_columns = FALSE,
  show_heatmap_legend = FALSE,

  show_row_names = TRUE,
  row_names_side = "left",
  row_labels = format_label(
    rownames(alpha_rho)
  ),
  row_names_gp = gpar(
    fontfamily = "Helvetica",
    fontsize = 5
  ),

  show_column_names = TRUE,
  column_names_gp = gpar(
    fontfamily = "Helvetica",
    fontsize = 5
  ),

  height = nrow(alpha_rho) *
    unit(3, "mm"),

  width = ncol(alpha_rho) *
    unit(3, "mm"),

  cell_fun = alpha_cell_function(
    alpha_rho,
    alpha_p
  ),

  row_split = row_split,
  left_annotation = left_annotation,

  right_annotation = rowAnnotation(
    mOTU_Beta_R2 = anno_barplot(
      motu_beta_matrix,
      gp = gpar(
        fill = bar_colors,
        lwd = 0.3
      ),
      axis = TRUE,
      axis_param = list(
        gp = gpar(
