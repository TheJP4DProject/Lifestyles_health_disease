#
# Statistical comparison:
#   paired DeLong test
# ============================================================

rm(list = ls())

library(dplyr)
library(tidyr)
library(ggplot2)
library(grid)

# ============================================================
# File paths
# ============================================================

AUC_FILE <- "data/model_10fold_auc_results.csv"
DELONG_FILE <- "data/model_10fold_delong_results.csv"

OUTPUT_PDF <- "results/model_10fold_auc_comparison.pdf"
OUTPUT_AUC_CSV <- "results/model_10fold_auc_summary.csv"
OUTPUT_DELONG_CSV <- "results/model_10fold_delong_summary.csv"

dir.create(
  dirname(OUTPUT_PDF),
  recursive = TRUE,
  showWarnings = FALSE
)

# ============================================================
# Model settings
# ============================================================

MODEL_LABELS <- c(
  "Clinical only" = "Host model",
  "MADE only" = "MADE model",
  "Clinical + MADE" = "MADE & Host model"
)

MODEL_ORDER <- c(
  "Host model",
  "MADE model",
  "MADE & Host model"
)

MODEL_COLORS <- c(
  "Host model" = "#BDBDBD",
  "MADE model" = "#84AEDD",
  "MADE & Host model" = "#D97B8A"
)

# ============================================================
# Disease order and plot labels
# ============================================================

DISEASE_ORDER <- c(
  "General health",
  "IBD",
  "IBS",
  "Liver cirrhosis",
  "T2D",
  "Dyslipidemia",
  "Hypertension",
  "Hyperuricemia",
  "IHD",
  "Heart failure",
  "Stroke",
  "Depression",
  "Rheumatoid arthritis",
  "Collagen disease",
  "Asthma",
  "COPD"
)

# ============================================================
# Read input data
# ============================================================

auc_data <- read.csv(
  AUC_FILE,
  check.names = FALSE,
  stringsAsFactors = FALSE
)

delong_data <- read.csv(
  DELONG_FILE,
  check.names = FALSE,
  stringsAsFactors = FALSE
)

# Input disease names are assumed to already match DISEASE_ORDER.

# ============================================================
# Calculate 95% CI from fold-level test AUC values
# ============================================================

fold_test_columns <- grep(
  "^fold[0-9]+_test_auc$",
  colnames(auc_data),
  value = TRUE
)

fold_test_columns <- fold_test_columns[
  order(
    as.integer(
      sub(
        "^fold([0-9]+)_test_auc$",
        "\\1",
        fold_test_columns
      )
    )
  )
]

calculate_fold_ci <- function(x) {

  x <- as.numeric(x)
  x <- x[is.finite(x)]

  n <- length(x)

  if (n < 2) {
    return(
      c(
        CI_low = NA_real_,
        CI_high = NA_real_
      )
    )
  }

  mean_auc <- mean(x)
  se_auc <- sd(x) / sqrt(n)

  critical_value <- qt(
    0.975,
    df = n - 1
  )

  c(
    CI_low = max(
      0.5,
      mean_auc - critical_value * se_auc
    ),
    CI_high = min(
      1,
      mean_auc + critical_value * se_auc
    )
  )
}

fold_ci <- t(
  apply(
    auc_data[
      ,
      fold_test_columns,
      drop = FALSE
    ],
    1,
    calculate_fold_ci
  )
)

auc_data$CI_low <- fold_ci[, "CI_low"]
auc_data$CI_high <- fold_ci[, "CI_high"]

# Ensure pooled AUC is inside the displayed interval
auc_data$CI_low <- ifelse(
  is.na(auc_data$CI_low),
  auc_data$pooled_test_auc,
  pmin(
    auc_data$CI_low,
    auc_data$pooled_test_auc
  )
)

auc_data$CI_high <- ifelse(
  is.na(auc_data$CI_high),
  auc_data$pooled_test_auc,
  pmax(
    auc_data$CI_high,
    auc_data$pooled_test_auc
  )
)

# ============================================================
# Prepare AUC plotting data
# ============================================================

plot_data <- auc_data %>%
  filter(
    model %in% names(MODEL_LABELS),
    tolower(status) %in% c(
      "success",
      "ok"
    )
  ) %>%
  mutate(
    Model = unname(
      MODEL_LABELS[model]
    ),

    Model = factor(
      Model,
      levels = MODEL_ORDER
    ),

    Disease = factor(
      outcome,
      levels = DISEASE_ORDER
    ),

    x_position = as.numeric(
      Model
    ),

    AUC_label = sprintf(
      "%.3f",
      pooled_test_auc
    )
  ) %>%
  arrange(
    Disease,
    Model
  )

# ============================================================
# Format DeLong P values
# ============================================================

format_p_value <- function(p) {

  if (is.na(p)) {
    return("P=NA")
  }

  if (p == 0) {
    return("P<1e-300")
  }

  scientific_value <- formatC(
    p,
    format = "e",
    digits = 2
  )

  parts <- strsplit(
    scientific_value,
    "e"
  )[[1]]

  paste0(
    "P=",
    parts[1],
    "e",
    as.integer(parts[2])
  )
}

# ============================================================
# Prepare DeLong brackets
# ============================================================

bracket_data <- delong_data %>%
  filter(
    model_1 %in% names(MODEL_LABELS),
    model_2 %in% names(MODEL_LABELS)
  ) %>%
  mutate(
    Model_1 = unname(
      MODEL_LABELS[model_1]
    ),

    Model_2 = unname(
      MODEL_LABELS[model_2]
    ),

    Disease = factor(
      outcome,
      levels = DISEASE_ORDER
    ),

    x1 = match(
      Model_1,
      MODEL_ORDER
    ),

    x2 = match(
      Model_2,
      MODEL_ORDER
    ),

    comparison_level = case_when(
      Model_1 == "Host model" &
        Model_2 == "MADE model" ~ 1,

      Model_1 == "Host model" &
        Model_2 == "MADE & Host model" ~ 2,

      Model_1 == "MADE model" &
        Model_2 == "MADE & Host model" ~ 3
    ),

    bracket_y = case_when(
      comparison_level == 1 ~ 0.98,
      comparison_level == 2 ~ 1.06,
      comparison_level == 3 ~ 1.14
    ),

    text_y = bracket_y + 0.012,

    x_middle = (
      x1 + x2
    ) / 2,

    P_label = vapply(
      p_value,
      format_p_value,
      character(1)
    )
  ) %>%
  filter(
    !is.na(x1),
    !is.na(x2),
    !is.na(bracket_y)
  )

